

# Public Sanity configuration used by the website in the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID="gzgpw4vv"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

# Public destination used by the static contact and careers forms.
NEXT_PUBLIC_FORM_RECIPIENT="edgrowproduct@gmail.com"

# Sanity Studio exposes only variables with the SANITY_STUDIO_ prefix.
SANITY_STUDIO_PROJECT_ID="gzgpw4vv"
SANITY_STUDIO_DATASET="production"

# Server-only token for reading a private dataset during static builds.
SANITY_API_READ_TOKEN="your-read-token"

# Server-only token with WRITE permission — required for the Hire Us / Contact form
# to save inquiries as hireInquiry documents in Sanity.
# Create one at: https://www.sanity.io/manage → your project → API → Tokens → Add token (Editor role)
SANITY_API_WRITE_TOKEN="your-write-token"
