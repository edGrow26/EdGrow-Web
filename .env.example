# Public Sanity configuration used by the website in the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

# Public destination used by the contact form.
NEXT_PUBLIC_FORM_RECIPIENT="edgrowproduct@gmail.com"

# Sanity Studio exposes only variables with the SANITY_STUDIO_ prefix.
SANITY_STUDIO_PROJECT_ID="your-project-id"
SANITY_STUDIO_DATASET="production"

# Server-only token for reading a private dataset.
SANITY_API_READ_TOKEN="your-read-token"

# Server-only token with create/update permission for career applications.
SANITY_API_WRITE_TOKEN="your-write-token"
